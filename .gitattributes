###############################################################################
# AWTLY - Git Attributes
###############################################################################

# All text files are stored as LF.
* text=auto eol=lf

###############################################################################
# Source code files
###############################################################################

*.py          text
*.pyw         text
*.awui        text
*.awcp        text
*.awsc        text
*.php         text
*.html        text
*.htm         text
*.css         text
*.js          text
*.json        text
*.xml         text
*.yml         text
*.yaml        text
*.ini         text
*.cfg         text
*.txt         text
*.md          text
*.gitignore   text
*.gitattributes text
*.editorconfig text
LICENSE       text

###############################################################################
# Scripts
###############################################################################

*.sh          text eol=lf
*.bat         text eol=crlf
*.cmd         text eol=crlf

###############################################################################
# Binarios
###############################################################################

*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.bmp         binary
*.ico         binary
*.svg         text
*.pdf         binary
*.zip         binary
*.7z          binary
*.gz          binary
